generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  role      String   @default("PRODUCER")
  
  // Farm Details
  farmName      String?
  farmLatitude  Float?
  farmLongitude Float?
  farmImage     String? // URL to primary image (kept for backward compatibility)
  farmImages    String? // JSON array of image URLs for gallery (max 6)
  
  // Producer Information
  profileImage  String? // Producer's profile photo/avatar
  bio           String? // Producer's story/description
  phone         String? // Contact phone
  certifications String? // Comma-separated certifications
  website       String? // Producer's website
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relation to Lot (Many-to-Many)
  lots      Lot[]
}

model Lot {
  id                   String   @id @default(uuid())
  code                 String   @unique
  
  // Producers (Many-to-Many)
  producers            User[]
  
  cropType             String
  
  // Lot specific location (Georeferencing)
  locationname         String? // Optional name/desc
  latitude             Float?
  longitude            Float?

  area                 Float
  unit                 String   @default("KG") // KG or LITERS
  
  // Production dates
  plantingDate         DateTime
  harvestDate          DateTime // Actual harvest date (required)
  
  // Harvest information
  harvestWeight        Float? // Total weight/quantity harvested
  quality              String? // Quality grade (A, B, C, Premium, etc.)
  certifications       String? // Comma-separated: Organic,Rainforest Alliance,Fair Trade
  storageLocation      String? // Where product is currently stored
  
  status               String   @default("ACTIVE")
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  events               Event[]
}

model Event {
  id          String   @id @default(uuid())
  lotId       String
  lot         Lot      @relation(fields: [lotId], references: [id])
  
  // Event type - simplified to focus on sales
  type        String   @default("SALE") // SALE primarily
  title       String
  description String?
  date        DateTime @default(now())
  location    String?
  
  // Sale-specific fields
  buyerName      String? // Name of wholesale buyer
  buyerType      String? // WHOLESALER, DISTRIBUTOR, RETAILER
  quantitySold   Float?  // Amount sold in this transaction
  
  createdBy   String?
  createdAt   DateTime @default(now())
}
